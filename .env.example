# Songyan（松烟）— 环境变量配置模板
# 复制本文件为 .env 并填入实际值
# .env 已加入 .gitignore，不会提交到仓库

# LLM 配置（通过 litellm 统一接口，默认 DeepSeek）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# 可选：备用模型配置（V1.0 不实现多模型路由，但 litellm 切换不需要改代码）
# LLM_FALLBACK_MODEL=gpt-4o
# LLM_FALLBACK_API_KEY=your-backup-key

# Token 预算（默认 32K，可手动调整到 48K/64K）
CONTEXT_TOTAL_BUDGET=32000
CONTEXT_GENERATION_RESERVE=8000

# 日志级别
LOG_LEVEL=INFO
