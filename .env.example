# Songyan（松烟）— 环境变量配置模板
# 复制本文件为 .env 并填入实际值
# .env 已加入 .gitignore，不会提交到仓库

# LLM 配置（通过 litellm 统一接口，默认 DeepSeek）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# 单 run LLM 成本预算（CNY，0 = 不启用；超预算立即熔断暂停 run，可 --resume 续跑）
# SONGYAN_RUN_COST_BUDGET=0

# 可选：备用模型配置（V1.0 不实现多模型路由，但 litellm 切换不需要改代码）
# LLM_FALLBACK_MODEL=gpt-4o
# LLM_FALLBACK_API_KEY=your-backup-key

# 可选：per-role 模型路由（V14，Task 231）
# 对单个生成角色覆盖 MODEL / BASE_URL / API_KEY；未配置的项回落到上方全局 LLM_*。
# 解析顺序：LLM_<ROLE>_* → 全局 LLM_* → 内置默认（deepseek-chat / api.deepseek.com）
# 可路由角色（10 个）：WRITER、REVISION_HANDLER、LLM_AUDITOR、LITERARY_AUDITOR、
#   SETTLEMENT_EXTRACTOR、SUMMARY_WRITER、GOAL_PLANNER、CREATIVE_DIRECTOR、
#   ARC_SUMMARY_GENERATOR、VOLUME_SUMMARY_GENERATOR
# 示例：Writer 用强模型、审核用便宜模型
# LLM_WRITER_MODEL=deepseek-reasoner
# LLM_LLM_AUDITOR_MODEL=deepseek-chat
# LLM_WRITER_BASE_URL=https://api.deepseek.com
# LLM_WRITER_API_KEY=role-specific-key
# 配置后可用 songyan doctor（--check-llm 会逐角色探测初始化）验证

# Token 预算（默认 32K，可手动调整到 48K/64K）
CONTEXT_TOTAL_BUDGET=32000
CONTEXT_GENERATION_RESERVE=8000

# 日志级别
LOG_LEVEL=INFO

# 数据库文件路径（默认 songyan.db，可自定义路径）
DATABASE_URL=sqlite:///songyan.db

# Checkpointer 模式（sqlite / memory）
# - sqlite: 生产环境，持久化 checkpoint
# - memory: 测试/验证环境，无文件锁（推荐 Windows 验证时使用）
CHECKPOINTER_MODE=sqlite
