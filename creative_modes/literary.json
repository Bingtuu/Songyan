    "narrative_hook": 0.6,
    "info_dump": 1.0,
    "dialogue_distinctness": 1.2,
    "dialogue_subtext": 1.5,
    "description_sensory": 1.5,
    "show_dont_tell": 1.5,
    "genre_numerical": 0.0
  },
  "active_audit_dimensions": [
    "world_consistency",
    "character_behavior",
    "timeline",
    "narrative_pacing",
    "narrative_hook",
    "info_dump",
    "dialogue_distinctness",
