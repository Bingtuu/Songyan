    "character_behavior": 1.0,
    "timeline": 1.0,
    "new_setting_unregistered": 1.0,
    "narrative_pacing": 1.5,
    "narrative_hook": 1.5,
    "info_dump": 1.2,
    "dialogue_distinctness": 1.0,
    "dialogue_subtext": 0.8,
    "description_sensory": 1.0,
    "show_dont_tell": 1.2,
    "genre_numerical": 1.5
  },
  "active_audit_dimensions": [
    "world_consistency",
    "character_behavior",
    "timeline",
    "new_setting_unregistered",
    "narrative_pacing",
    "narrative_hook",
    "info_dump",
    "dialogue_distinctness",
    "dialogue_subtext",
    "description_sensory",
    "show_dont_tell",
    "genre_numerical"
  ],
  "revision_policy": "standard",
  "tolerance": {
