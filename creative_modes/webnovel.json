{
  "id": "webnovel",
  "name": "网文模式",
  "enabled_agents": {
    "pre_write": ["goal_planner", "creative_director"],
    "write": ["writer"],
    "post_write": ["rule_auditor", "llm_auditor", "literary_auditor"],
    "revision": ["revision_handler"],
    "settlement": ["settlement_extractor"]
  },
  "audit_weights": {
