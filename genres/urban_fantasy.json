  "pacing_rule": "日常伪装章与异能事件章交替推进，觉醒章必须在 800 字内完成能力首次展示，冲突章需在 500 字内进入对抗核心。",
  "writer_rules": [
    "现代都市背景必须符合现实逻辑，异能设定需有明确限制和代价",
    "主角隐藏身份时，周围人物的怀疑和试探需有合理铺垫",
    "异能等级或能力体系必须前后一致，禁止临时新增能力解决困境",
    "势力冲突需符合现实社会规则，禁止随意破坏社会秩序而无后果",
    "配角必须有独立动机，禁止完全为衬托主角而存在的工具人"
  ],
  "reviewer_focus": [
    "异能设定是否前后一致，限制和代价是否明确",
    "隐藏身份的逻辑是否合理，周围人物的反应是否自然",
    "势力冲突是否符合现实社会规则",
    "配角是否有独立动机和行为逻辑"
